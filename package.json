{
  "name": "@showi/harness",
  "version": "0.3.3",
  "description": "El método —SDD, TDD, contrato de parada y verificación— llevado a cualquier proyecto y a cualquier herramienta desde una sola fuente",
  "type": "module",
  "license": "MIT",
  "bin": {
    "showi": "src/cli.mjs"
  },
  "files": [
    "src",
    "skills",
    "rules",
    "templates",
    "instrumentacion",
    "schema",
    "presets"
  ],
  "scripts": {
    "test": "node --test 'test/**/*.test.mjs' && python3 -m unittest discover -s test -p 'test_*.py'",
    "test:js": "node --test 'test/**/*.test.mjs'",
    "test:py": "python3 -m unittest discover -s test -p 'test_*.py'",
    "integridad": "bash test/integridad.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "agents",
    "agents-md",
    "skills",
    "spec-driven-development",
    "tdd",
    "claude-code",
    "cursor",
    "copilot",
    "kiro",
    "opencode"
  ],
  "peerDependenciesMeta": {
    "rulesync": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "yaml": "2.9.0"
  }
}
